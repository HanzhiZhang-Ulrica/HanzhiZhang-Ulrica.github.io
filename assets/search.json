---
layout: null
sitemap: false
---
[
{% assign separator = '' %}
{% assign search_documents = site.pages | concat: site.documents %}
{% for document in search_documents %}
{% if document.title and document.url != '/404.html' and document.search != false %}
{% capture search_content %}
{% case document.url %}
{% when '/service/' %}
{{ document.title }}
Conference Reviewer. {% for group in site.data.services.conference %}{{ group.field }}: {{ group.venues | join: '; ' }}. {% endfor %}
Journal Reviewer: {{ site.data.services.journals | join: '; ' }}.
External Reviewer: {{ site.data.services.external | join: '; ' }}.
{% for entry in site.data.services.volunteering %}Student Volunteer, {{ entry.event }}, {{ entry.institution }}, {{ entry.date }}. {% endfor %}
{% when '/talks/' %}
{{ document.title }}
{% for entry in site.data.talks.entries %}{{ entry.title }}. {{ entry.type }}, {{ entry.venue }}, {{ entry.term | default: entry.year }}. {{ entry.details }} {% endfor %}
{% else %}
{{ document.content }}
{% endcase %}
{% endcapture %}
{{ separator }}{
  "title": {{ document.title | strip_html | jsonify }},
  "url": {{ document.redirect_to | default: document.url | relative_url | jsonify }},
  "content": {{ search_content | markdownify | strip_html | replace: '
', ' ' | jsonify }}
}
{% assign separator = ',' %}
{% endif %}
{% endfor %}
{% for news in site.data.news %}
{{ separator }}{"title": {{ news.date_label | prepend: 'News · ' | jsonify }}, "url": {{ '/news/' | relative_url | append: '#news-' | append: forloop.index | jsonify }}, "content": {{ news.text | jsonify }}}
{% assign separator = ',' %}
{% endfor %}
]
